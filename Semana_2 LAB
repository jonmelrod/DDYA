    "#Mercado\n",
    "#Menor a mayor y Mayor a menor\n",
    "\n",
    "def asce(lista, l):\n",
    "    lista =[]\n",
    "    s = 0\n",
    "    while s < l:\n",
    "        ask = input(\"Ingrese el precio: \")\n",
    "        for n in ask.split(\",\"):\n",
    "            lista.append(int(n))\n",
    "        s += 1\n",
    "    for i in range(1, len(lista)):\n",
    "        clave = lista[i]\n",
    "        j = i - 1\n",
    "        while j >= 0 and lista[j] > clave:\n",
    "            lista[j + 1] = lista[j]\n",
    "            j -= 1\n",
    "\n",
    "        lista[j + 1] = clave\n",
    "\n",
    "    print(\"La secuencia ordenada de menor a mayor es:\", lista)\n",
    "    return lista\n",
    "\n",
    "def desce(lista, l):\n",
    "    lista =[]\n",
    "    s = 0\n",
    "    while s < l:\n",
    "        ask = input(\"Ingrese el precio: \")\n",
    "        for n in ask.split(\",\"):\n",
    "            lista.append(int(n))\n",
    "        s += 1\n",
    "    for i in range(1, len(lista)):\n",
    "        clave = lista[i]\n",
    "        j = i - 1\n",
    "\n",
    "        while j >= 0 and lista[j] < clave:\n",
    "            lista[j + 1] = lista[j]\n",
    "            j -= 1\n",
    "\n",
    "        lista[j + 1] = clave\n",
    "\n",
    "    print(\"La secuencia ordenada de mayor a menor es:\", lista)\n",
    "    return lista\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "def main():\n",
    "    l = int(input(\"Ingrese cuantos precios va a ingresar: \"))\n",
    "    lista = []\n",
    "\n",
    "    n = input(\"desea ascendente (asce) o descente (desce): \")\n",
    "    if n == \"asce\":\n",
    "        lista = asce(lista, l)\n",
    "        \n",
    "    elif n == \"desce\":  \n",
    "        lista = desce(lista,l)\n",
    "\n",
    "\n",
    "\n",
    "main()"
