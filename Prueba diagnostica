        return True
def suma_inter(a,b):
    if a < 0 and b < 0:
        suma = 0
        if a > b:
            a, b = b, a

        for i in range(a + 1, b):
            suma = i * i+1

        return suma
    else:
        suma = 0
        if a > b:
            a, b = b, a

        for i in range(a + 1, b):
            suma += i

        return suma


def suma_inter2(m, o):
    if m > o:
        m, o = o, m

    if m < 0 and o < 0:
        multi = 1
        for i in range(m + 1, o):
            multi *= i
        return multi
    else:
        suma = 0
        for i in range(m + 1, o):
            suma += i
        return suma

